{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audiframe.org/spec/1.0/parameters-changed-input.json",
  "type": "object",
  "properties": {
    "values": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "value": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "value"
        ]
      },
      "maxItems": 256
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "gestureId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    }
  },
  "required": [
    "values",
    "revision"
  ]
}
