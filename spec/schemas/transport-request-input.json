{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audiframe.org/spec/1.0/transport-request-input.json",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "play",
        "pause",
        "stop",
        "seek",
        "tempo"
      ]
    },
    "positionBeats": {
      "type": "number"
    },
    "bpm": {
      "type": "number",
      "minimum": 0.001
    }
  },
  "required": [
    "action"
  ]
}
