{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audiframe.org/spec/1.0/files-chunk-input.json",
  "type": "object",
  "properties": {
    "transferId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "byteLength": {
      "type": "integer",
      "minimum": 1,
      "maximum": 262144
    },
    "buffer": {}
  },
  "required": [
    "transferId",
    "index",
    "byteLength",
    "buffer"
  ]
}
