{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audiframe.org/spec/1.0/connect-bind.json",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "version": {
      "type": "object",
      "properties": {
        "major": {
          "type": "integer",
          "minimum": 1
        },
        "minor": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "major",
        "minor"
      ]
    },
    "grants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "version": {
            "const": 1
          },
          "options": {
            "type": "object"
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "version"
        ]
      },
      "maxItems": 32
    },
    "limits": {
      "type": "object",
      "properties": {
        "envelopeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "stateBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "pending": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "batch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "eventsPerSecond": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "eventBurst": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        }
      },
      "required": [
        "envelopeBytes",
        "stateBytes",
        "depth",
        "pending",
        "batch",
        "eventsPerSecond",
        "eventBurst"
      ]
    }
  },
  "required": [
    "sessionId",
    "version",
    "grants",
    "limits"
  ]
}
