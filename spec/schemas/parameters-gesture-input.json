{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audiframe.org/spec/1.0/parameters-gesture-input.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "gestureId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "phase": {
      "type": "string",
      "enum": [
        "begin",
        "end"
      ]
    }
  },
  "required": [
    "id",
    "gestureId",
    "phase"
  ]
}
