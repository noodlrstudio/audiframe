{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audiframe.org/spec/1.0/files-import-output.json",
  "type": "object",
  "properties": {
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "transferId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "mimeType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "transferId",
          "name",
          "mimeType",
          "size"
        ]
      },
      "maxItems": 32
    }
  },
  "required": [
    "files"
  ]
}
