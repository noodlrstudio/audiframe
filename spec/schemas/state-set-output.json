{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audiframe.org/spec/1.0/state-set-output.json",
  "type": "object",
  "properties": {
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "epoch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    }
  },
  "required": [
    "revision",
    "epoch"
  ]
}
