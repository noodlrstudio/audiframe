{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audiframe.org/spec/1.0/session-grants-input.json",
  "type": "object",
  "properties": {
    "grants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "version": {
            "const": 1
          },
          "options": {
            "type": "object"
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "version"
        ]
      },
      "maxItems": 32
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    }
  },
  "required": [
    "grants",
    "reason"
  ]
}
