{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audiframe.org/spec/1.0/connect-offer.json",
  "type": "object",
  "properties": {
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "major": {
            "type": "integer",
            "minimum": 1
          },
          "minor": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "major",
          "minor"
        ]
      },
      "maxItems": 16
    },
    "host": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "id",
        "name",
        "version"
      ]
    },
    "requestedCapabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "maxItems": 32
    }
  },
  "required": [
    "versions",
    "host",
    "requestedCapabilities"
  ]
}
