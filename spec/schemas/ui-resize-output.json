{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audiframe.org/spec/1.0/ui-resize-output.json",
  "type": "object",
  "properties": {
    "width": {
      "type": "integer",
      "minimum": 0
    },
    "height": {
      "type": "integer",
      "minimum": 0
    },
    "accepted": {
      "type": "boolean"
    }
  },
  "required": [
    "width",
    "height",
    "accepted"
  ]
}
