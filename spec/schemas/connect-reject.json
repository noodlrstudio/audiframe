{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audiframe.org/spec/1.0/connect-reject.json",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "UNSUPPORTED_VERSION",
        "CAPABILITY_DENIED"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    }
  },
  "required": [
    "code"
  ]
}
