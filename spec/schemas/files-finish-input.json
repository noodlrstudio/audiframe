{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audiframe.org/spec/1.0/files-finish-input.json",
  "type": "object",
  "properties": {
    "transferId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "totalBytes": {
      "type": "integer",
      "minimum": 0
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "transferId",
    "totalBytes",
    "sha256"
  ]
}
